# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ShakeShake Mobile — API Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# ALL backend calls go through EXPO_PUBLIC_API_BASE_URL.
# The gateway (port 23010) routes to the right service:
#   /auth/*       → auth service       (23000)
#   /settings/*   → auth service       (23000)
#   /onboarding/* → onboarding service (23001)
#   /profile/*    → profile service    (23002)
#   /match/*      → match service      (23003)
#   /chat/*       → match service      (23003)
#   /ollama/*     → match service      (23003)
#
# ── Setup ──────────────────────────────────────────────────────────
#
# 1. Start the backend:
#      cd shakeshake-backend && python start_all.py
#
# 2. Start ngrok (one command):
#      ./start-ngrok.sh
#    This writes the HTTPS URL below automatically.
#
# 3. Start Expo (clear cache to pick up new .env):
#      npx expo start -c
#
# ── Or set the URL manually ────────────────────────────────────────
#
# Get your URL from https://dashboard.ngrok.com/tunnels or run:
#   curl -s http://127.0.0.1:4040/api/tunnels | grep public_url
#
EXPO_PUBLIC_API_BASE_URL=

# ── Mock Data ─────────────────────────────────────────────────────
# "true"  = always use local mock data (never hits backend)
# "false" = use real backend APIs (auto-falls back to mocks if unreachable)
EXPO_PUBLIC_USE_MOCKS=false
